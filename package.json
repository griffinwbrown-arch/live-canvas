{
  "name": "kamvas-live-canvas",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "test:overlay": "node tests/capture-overlay.mjs",
    "test:pointer": "node tests/pointer.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:packaged": "node tests/packaged.mjs",
    "package:win": "pnpm build && node scripts/stage-package.mjs && electron-builder --win --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "demo:chrome": "node scripts/demo-chrome.mjs"
  },
  "dependencies": {
    "@tldraw/assets": "5.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tldraw": "5.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.58.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "description": "Capture a screen, draw over it live, and copy or save the result.",
  "author": "Griffin Brown",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.19.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/griffinwbrown-arch/live-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/griffinwbrown-arch/live-canvas/issues"
  }
}
